# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production
DEBUG=false
API_PREFIX=/api/v1

# Cache Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=500

# Rate Limiting & Concurrency
MAX_CONCURRENT_REQUESTS=3
REQUEST_TIMEOUT_SECONDS=15.0

# Optional: LinkedIn Session Credentials for Deep Voyager API Extraction (Leave empty for Zero-Cookie Public Mode)
# You can provide individual tokens OR paste the entire copied cookie string from DevTools:
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
LINKEDIN_COOKIES=

# Optional: User-Agent Override (matches Chromium 151)
USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/151.0.0.0 Safari/537.36"
